{
  "name": "@aignostics/monorepo",
  "version": "0.0.0-development",
  "description": "Monorepo for Aignostics Platform TypeScript SDK and CLI",
  "type": "module",
  "private": true,
  "packageManager": "npm@12.2.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:sdk": "turbo run build --filter=@aignostics/sdk",
    "build:cli": "turbo run build --filter=@aignostics/cli",
    "test": "turbo run test",
    "test:sdk": "turbo run test --filter=@aignostics/sdk",
    "test:cli": "turbo run test --filter=@aignostics/cli",
    "test:cli:e2e": "turbo run test:e2e --filter=@aignostics/cli",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "lint:sdk": "turbo run lint --filter=@aignostics/sdk",
    "lint:cli": "turbo run lint --filter=@aignostics/cli",
    "typecheck": "turbo run typecheck",
    "typecheck:sdk": "turbo run typecheck --filter=@aignostics/sdk",
    "typecheck:cli": "turbo run typecheck --filter=@aignostics/cli",
    "codegen": "turbo run codegen --filter=@aignostics/sdk",
    "update-spec": "turbo run update-spec --filter=@aignostics/sdk",
    "clean": "rm -rf dist packages/*/dist packages/*/coverage",
    "docs": "typedoc packages/sdk/src/index.ts --out docs --exclude '**/*.test.ts' --exclude 'packages/sdk/src/generated/**'",
    "docs:serve": "npx http-server docs -p 8080",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-attributions": "node scripts/generate-attributions.js",
    "analyze-licenses": "node scripts/analyze-licenses.js",
    "check-license-policy": "node scripts/check-license-policy.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aignostics/typescript-sdk.git"
  },
  "keywords": [
    "aignostics",
    "platform",
    "sdk",
    "typescript",
    "api"
  ],
  "author": "Aignostics",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aignostics/typescript-sdk/issues"
  },
  "homepage": "https://github.com/aignostics/typescript-sdk#readme",
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "chalk": "6.0.1",
    "execa": "10.2.1",
    "fishery": "2.4.0",
    "fs-extra": "11.4.1",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "3.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsdown": "0.23.7",
    "turbo": "2.11.10",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
