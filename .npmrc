# @aignostics packages are published to GitHub Packages. Installing them needs
# a GitHub token with read:packages in your user-level ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=<token>
@aignostics:registry=https://npm.pkg.github.com/

# Fail the install when a dependency has an install script that the
# allowScripts field in package.json does not cover. Without this, npm 11
# runs such scripts with a warning and npm 12 skips them with a warning.
strict-allow-scripts=true
