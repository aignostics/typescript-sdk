{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "out-tsc",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.app.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [{ "path": "../sdk/tsconfig.lib.json" }]
}
