{
  "name": "@aignostics/cli",
  "version": "4.0.0",
  "description": "CLI for Aignostics",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "aignostics": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vite.config.ts --passWithNoTests",
    "test:e2e": "vitest run --config e2e/vite.config.e2e.ts --passWithNoTests --reporter=verbose",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "typecheck": "tsc --noEmit --project tsconfig.app.json"
  },
  "keywords": [
    "aignostics",
    "platform",
    "cli",
    "typescript"
  ],
  "author": "Aignostics",
  "license": "MIT",
  "dependencies": {
    "@aignostics/sdk": "^3.6.1",
    "@napi-rs/keyring": "^1.1.8",
    "cli-table3": "^0.6.5",
    "express": "^5.1.0",
    "open": "^11.0.0",
    "openid-client": "^5",
    "yargs": "^18.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/yargs": "17.0.35",
    "dotenv": "17.4.2",
    "playwright": "1.62.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
