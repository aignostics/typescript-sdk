{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "out-tsc",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "types": ["node", "vitest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
