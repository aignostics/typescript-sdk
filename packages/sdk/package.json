{
  "name": "@aignostics/sdk",
  "version": "3.7.0",
  "description": "The TypeScript SDK for Aignostics",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./test": {
      "types": "./dist/test-utils/http-mocks.d.ts",
      "import": "./dist/test-utils/http-mocks.js",
      "require": "./dist/test-utils/http-mocks.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vite.config.ts --passWithNoTests",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "typecheck": "tsc --noEmit --project tsconfig.lib.json",
    "codegen": "rm -rf src/generated && docker run --rm -v ${PWD}/../..:/local --user $(id -u):$(id -g) openapitools/openapi-generator-cli:v7.14.0 generate -i /local/packages/sdk/openapi.json -g typescript-axios -o /local/packages/sdk/src/generated --additional-properties=supportsES6=true,withInterfaces=true,typescriptThreePlus=true,useSingleRequestParameter=true,importFileExtension=.js",
    "update-spec": "curl -fsSL https://platform-staging.aignostics.com/api/v1/openapi.json | jq . > openapi.json && npm run codegen"
  },
  "keywords": [
    "aignostics",
    "platform",
    "sdk",
    "typescript",
    "api"
  ],
  "author": "Aignostics",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "p-retry": "^8.0.0",
    "zod": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
