{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**"],
      "cache": false,
      "env": [
        "E2E_REFRESH_TOKEN",
        "E2E_TEST_ENVIRONMENT",
        "E2E_ADMIN_USER_EMAIL",
        "E2E_ADMIN_USER_PASSWORD"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "codegen": {
      "cache": false
    },
    "update-spec": {
      "cache": false
    }
  }
}
